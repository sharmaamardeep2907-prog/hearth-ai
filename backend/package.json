{
  "name": "hearth-ai-backend",
  "version": "1.0.0",
  "description": "HEARTH AI — Enterprise-Grade AI-Powered Service Marketplace Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern='src/tests/unit'",
    "test:integration": "jest --testPathPattern='src/tests/integration'",
    "seed": "tsx src/seed/index.ts",
    "seed:clean": "tsx src/seed/clean.ts",
    "seed:demo": "tsx src/seed/demo.ts",
    "docs": "npx swagger-jsdoc -d src/docs/spec.ts -o src/docs/swagger.json",
    "health": "curl http://localhost:5000/health"
  },
  "dependencies": {
    "express": "^4.21.0",
    "mongoose": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.4.0",
    "express-mongo-sanitize": "^2.2.0",
    "hpp": "^0.2.3",
    "cookie-parser": "^1.4.6",
    "morgan": "^1.10.0",
    "zod": "^3.23.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "winston-daily-rotate-file": "^5.0.0",
    "socket.io": "^4.8.0",
    "socket.io-redis": "^6.1.0",
    "nodemailer": "^6.9.0",
    "google-auth-library": "^9.12.0",
    "@google/generative-ai": "^0.18.0",
    "razorpay": "^2.9.0",
    "cloudinary": "^2.4.0",
    "node-cron": "^3.0.3",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "otplib": "^12.0.1",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.0",
    "swagger-jsdoc": "^6.2.0",
    "swagger-ui-express": "^5.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/express": "^4.17.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.0",
    "@types/nodemailer": "^6.4.0",
    "@types/uuid": "^10.0.0",
    "@types/qrcode": "^1.5.0",
    "@types/multer": "^1.4.0",
    "@types/swagger-jsdoc": "^6.0.0",
    "@types/swagger-ui-express": "^4.1.0",
    "typescript": "^5.4.0",
    "tsx": "^4.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.0",
    "supertest": "^6.3.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "prettier": "^3.3.0"
  }
}
