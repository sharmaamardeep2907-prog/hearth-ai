NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hearth-ai-prod
JWT_ACCESS_SECRET=<generate-64-char-random>
JWT_REFRESH_SECRET=<generate-64-char-random>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=https://hearth.ai
GEMINI_API_KEY=<gemini-key>
GOOGLE_MAPS_API_KEY=<maps-key>
RAZORPAY_KEY_ID=<razorpay-key>
RAZORPAY_KEY_SECRET=<razorpay-secret>
CLOUDINARY_CLOUD_NAME=<cloud-name>
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=<sendgrid-key>
BCRYPT_ROUNDS=12
AI_ENABLED=true
MAPS_ENABLED=true
PAYMENTS_ENABLED=true
NOTIFICATIONS_ENABLED=true
SOCKET_ENABLED=true